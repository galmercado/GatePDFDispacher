# cp .env.example .env  and replace every value below.
# Generate secrets with: openssl rand -hex 32
SECRET_KEY=change-me
EVOLUTION_API_KEY=change-me
POSTGRES_PASSWORD=change-me
EVOLUTION_INSTANCE=event-door
# Minimum seconds between WhatsApp messages (floor: 1.0) plus up to WHATSAPP_JITTER random extra.
WHATSAPP_MIN_INTERVAL=1.5
WHATSAPP_JITTER=0.5
# Address phones scanning QR codes can reach, e.g. http://192.168.1.20:8000 or https://tickets.example.org.
# Leave empty to use whatever address the doorman's browser is using (never use localhost).
PUBLIC_BASE_URL=
# Set to true once served over HTTPS.
COOKIE_SECURE=false
# Prepended to local phone numbers (052-5607772 -> 972525607772). Numbers with +/00 are left alone.
DEFAULT_COUNTRY_CODE=972

# --- Google sign-in (optional; see README "Google sign-in") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra admin created at startup that signs in with Google (must be a real Google account email).
ADMIN_EMAIL=

# --- Production only (see README "Deploy") ---
# Public hostname served by Caddy, e.g. tickets.example.org  (DNS A record -> your server IP)
DOMAIN=localhost
# 127.0.0.1 in production so the app is reachable only through Caddy; keep 0.0.0.0 for local/LAN use
APP_BIND=0.0.0.0

# Ticket messages are deleted for everyone when the guest is admitted, and after this many hours (0 = never; keep < 46).
WHATSAPP_AUTO_DELETE_HOURS=24
WHATSAPP_DELETE_ON_ADMIT=true
