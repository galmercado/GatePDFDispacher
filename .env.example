# cp .env.example .env  and replace every value below.
# Generate secrets with: openssl rand -hex 32
SECRET_KEY=change-me
EVOLUTION_API_KEY=change-me
POSTGRES_PASSWORD=change-me
EVOLUTION_INSTANCE=event-door
# Minimum seconds between WhatsApp messages (floor: 1.0) plus up to WHATSAPP_JITTER random extra.
WHATSAPP_MIN_INTERVAL=1.5
WHATSAPP_JITTER=0.5
# Address phones scanning QR codes can reach, e.g. http://192.168.1.20:8000 or https://tickets.example.org.
# Leave empty to use whatever address the doorman's browser is using (never use localhost).
PUBLIC_BASE_URL=
# Set to true once served over HTTPS.
COOKIE_SECURE=false
# Prepended to local phone numbers (052-5607772 -> 972525607772). Numbers with +/00 are left alone.
DEFAULT_COUNTRY_CODE=972
